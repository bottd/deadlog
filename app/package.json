{
	"name": "deadlog-web",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"redirects": "tsx ../scripts/generate-redirects.ts",
		"dev": "pnpm run redirects && vite dev --port 5173",
		"build": "pnpm run redirects && vite build",
		"preview": "vite preview --port 4173",
		"check": "pnpm run redirects && svelte-kit sync && svelte-check --tsconfig tsconfig.json && tsc --project tsconfig.worker.json",
		"test": "pnpm run redirects && vitest run",
		"test:e2e": "playwright test --config playwright.config.ts",
		"lint": "eslint ."
	},
	"dependencies": {
		"@deadlog/db": "workspace:*",
		"@deadlog/utils": "workspace:*"
	}
}
