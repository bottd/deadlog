{
	"name": "deadlog.io",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter 'deadlog-web' dev",
		"build": "pnpm --filter 'deadlog-web' build",
		"preview": "pnpm --filter 'deadlog-web' preview",
		"screenshot": "tsx scripts/capture-homepage.ts",
		"test": "pnpm run test:all",
		"test:all": "pnpm -r --if-present run test",
		"test:e2e": "pnpm --filter 'deadlog-web' test:e2e",
		"check": "pnpm --filter 'deadlog-web' check && pnpm check:libs && pnpm check:scripts",
		"check:libs": "tsc --noEmit --project lib/scraper/tsconfig.json && tsc --noEmit --project lib/meta/tsconfig.json",
		"check:scripts": "tsc --noEmit --project scripts/tsconfig.json",
		"lint": "pnpm --filter 'deadlog-web' lint && pnpm lint:scripts",
		"lint:scripts": "eslint scripts",
		"format": "prettier --write .",
		"format:scripts": "prettier --write scripts",
		"fmt:check": "prettier --check .",
		"fmt:check:scripts": "prettier --check scripts",
		"build:scraper": "tsx lib/scraper/src/cli.ts",
		"build:db": "tsx lib/scraper/src/cli.ts --db-only && pnpm run build:redirects",
		"build:redirects": "pnpm --filter 'deadlog-web' redirects",
		"clean:meta": "rm -rf app/static/assets/meta",
		"build:meta": "pnpm run clean:meta && UV_THREADPOOL_SIZE=8 tsx lib/meta/src/generate-previews.ts",
		"mcp:fixture:export": "tsx scripts/export-mcp-fixture.ts",
		"test:mcp:fixtures": "vitest run --config scripts/vitest.config.ts",
		"mcp:db:migrate:local": "wrangler d1 migrations apply DB --local --config mcp/wrangler.toml",
		"mcp:fixture:publish": "tsx scripts/publish-mcp-fixture.ts",
		"build:mcp": "pnpm --filter deadlog-embed build && tsx scripts/build-mcp-resource.ts && pnpm --filter deadlog-mcp build",
		"test:mcp": "pnpm --filter deadlog-mcp test:protocol",
		"mcp:probe:stats": "tsx scripts/probe-mcp-stats.ts",
		"check:mcp": "pnpm --filter @deadlog/contracts check && pnpm --filter @deadlog/core check && pnpm --filter @deadlog/host check && tsc --noEmit -p lib/db/tsconfig.json && pnpm --filter deadlog-mcp check && pnpm --filter deadlog-embed check && pnpm run check:scripts",
		"lint:mcp": "eslint lib/contracts/src lib/core/src lib/host/src lib/db/src/d1.ts lib/db/src/sqlite.ts lib/db/src/patch-repository.ts lib/db/src/publication.ts lib/db/src/patch-repository.test.ts mcp/src mcp/tests embed/src embed/e2e embed/playwright.config.ts embed/vite.config.ts embed/svelte.config.js vitest.mcp.config.ts",
		"test:embed": "pnpm --filter deadlog-embed test:e2e",
		"mcp:db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging --config mcp/wrangler.toml",
		"deploy:mcp:staging": "tsx scripts/retain-mcp-resources.ts && pnpm run build:mcp && wrangler deploy --env staging --config mcp/wrangler.toml",
		"inspect:mcp": "pnpm --filter deadlog-mcp inspect"
	},
	"dependencies": {
		"@deadlog/db": "workspace:*",
		"@deadlog/utils": "workspace:*",
		"@deadlog/contracts": "workspace:*",
		"@deadlog/core": "workspace:*",
		"@deadlog/changelog": "workspace:*"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.31.0",
		"@modelcontextprotocol/inspector-cli": "1.0.1",
		"@cloudflare/workers-types": "5.20260919.1",
		"@counterscale/tracker": "3.4.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@libsql/client": "0.18.0",
		"@lucide/svelte": "1.47.0",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@takumi-rs/core": "2.14.0",
		"@takumi-rs/helpers": "2.14.0",
		"@tanstack/svelte-query": "6.2.1",
		"@testing-library/jest-dom": "7.0.1",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@vitest/browser": "5.0.1",
		"@vitest/browser-playwright": "5.0.1",
		"bits-ui": "2.19.2",
		"deadlock-api-client": "github:deadlock-api/openapi-clients#4b45412fd49f08410630c1bd5ccccb8e455bcbc4&path:typescript",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"happy-dom": "20.14.5",
		"msw": "2.15.0",
		"playwright": "1.63.0",
		"prettier": "3.9.8",
		"prettier-plugin-sql": "0.20.0",
		"prettier-plugin-svelte": "4.1.1",
		"react": "19.3.0",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"svelte-meta-tags": "5.0.2",
		"svelte-sonner": "1.2.1",
		"tsx": "4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"unocss": "66.10.5",
		"vite": "8.3.0",
		"vite-plugin-mog": "0.2.1",
		"vitest": "5.0.1",
		"wrangler": "4.135.0",
		"zod": "4.6.5"
	}
}
