{
	"name": "deadlog.io",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter 'deadlog-web' dev",
		"build": "pnpm --filter 'deadlog-web' build",
		"preview": "pnpm --filter 'deadlog-web' preview",
		"test": "pnpm run test:all",
		"test:all": "pnpm -r --if-present run test",
		"test:e2e": "pnpm --filter 'deadlog-web' test:e2e",
		"check": "pnpm --filter 'deadlog-web' check",
		"lint": "pnpm --filter 'deadlog-web' lint",
		"format": "prettier --write .",
		"fmt:check": "prettier --check .",
		"build:scraper": "tsx --tsconfig=tsconfig.base.json lib/scraper/src/cli.ts",
		"build:db": "tsx --tsconfig=tsconfig.base.json lib/scraper/src/cli.ts --db-only",
		"build:meta": "DATABASE_URL=file:app/static/deadlog.db tsx --tsconfig=tsconfig.base.json lib/meta/src/generate-previews.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260821.1",
		"@counterscale/tracker": "3.4.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.3",
		"@libsql/client": "0.17.4",
		"@lucide/svelte": "1.33.0",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@takumi-rs/core": "2.10.0",
		"@takumi-rs/helpers": "2.10.0",
		"@tanstack/svelte-query": "6.1.38",
		"@testing-library/jest-dom": "7.0.1",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"bits-ui": "2.19.0",
		"deadlock-api-client": "github:deadlock-api/openapi-clients#path:typescript",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"happy-dom": "20.11.6",
		"msw": "2.15.0",
		"playwright": "1.62.1",
		"prettier": "3.9.6",
		"prettier-plugin-sql": "0.20.0",
		"prettier-plugin-svelte": "4.1.1",
		"react": "19.2.8",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"svelte-meta-tags": "5.0.2",
		"svelte-sonner": "1.2.1",
		"tsx": "4.23.12",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"unocss": "66.8.0",
		"vite": "8.2.2",
		"vite-plugin-mog": "0.2.1",
		"vitest": "4.1.11",
		"wrangler": "4.125.0",
		"zod": "4.4.3"
	}
}
